# YouTube Data API v3 key
# Get one at: https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL=channel_name_or_handle

# Paths are relative to the directory where you run the scripts.
# Generated files are separate from the committed data/ samples.
YOUTUBE_OUTPUT_DIR=output
YOUTUBE_VIDEO_IDS_FILE=video_ids.txt
# Optional earlier chapter run to combine with output/data_s2.json.
YOUTUBE_CHAPTER_BASE_FILE=output/data_s.json

# Browser wait timeout and pauses between page interactions, in seconds.
YOUTUBE_BROWSER_WAIT=5
YOUTUBE_PAGE_DELAY=2

# 0 preserves the original full collection; use 5 for a small test.
YOUTUBE_MAX_VIDEOS=0
# Set false for a small metadata-only run, avoiding all playlist traversal.
YOUTUBE_INCLUDE_PLAYLISTS=true
